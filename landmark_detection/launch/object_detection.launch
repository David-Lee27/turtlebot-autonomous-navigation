<launch>
  <arg name="floor" default="downstairs" />

  <!-- Landmarks file selection based on floor -->
  <arg name="landmarks_file" default="$(eval '/home/david/habitat_ws/src/image_logger/scripts/downstairs_landmarks.yaml' if arg('floor') == 'downstairs' else '/home/david/habitat_ws/src/image_logger/scripts/upstairs_landmarks.yaml')" />

  <!-- Run explore_lite for autonomous exploration -->
  <node
    pkg="explore_lite"
    type="explore"
    name="explore"
    output="screen">
    <param name="planner_frequency" value="1.0" />
    <param name="planner_patience" value="5.0" />
  </node>

  <!-- Run object detector and landmark logger -->
  <node
    pkg="image_logger"
    type="object_detector_and_logger.py"
    name="object_detector"
    output="screen">
    <param name="image_topic" value="/zed2/zed_node/rgb/image_rect_color" />
    <param name="landmarks_file" value="$(arg landmarks_file)" />
  </node>

  <!-- Run controller node to save landmarks -->
  <node
    pkg="image_logger"
    type="controller_node.py"
    name="controller_node"
    output="screen">
    <param name="landmarks_file" value="$(arg landmarks_file)" />
  </node>
</launch>

