<launch>
  <!-- Arguments -->
  <arg name="model" default="waffle" />
  <arg name="open_rviz" default="true" />
  <arg name="scan_topic" default="/scan3" />

  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro'" />

  <!-- Robot State Publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />

  <!-- Gmapping SLAM -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_footprint" />
    <param name="odom_frame" value="odom" />
    <param name="map_update_interval" value="5.0" />
    <param name="maxUrange" value="3.5" />
    <param name="sigma" value="0.05" />
    <param name="kernelSize" value="1" />
    <param name="lstep" value="0.05" />
    <param name="astep" value="0.05" />
    <param name="iterations" value="5" />
    <param name="lsigma" value="0.075" />
    <param name="minimumScore" value="200" />
    <param name="delta" value="0.1" />
    <param name="resampleThreshold" value="0.5" />
    <param name="particles" value="30" />
    <remap from="scan" to="$(arg scan_topic)" />
  </node>

  <!-- Move base -->
  <include file="$(find turtlebot3_navigation)/launch/move_base.launch" />

  <!-- Exploration node -->
  <node pkg="explore_lite" type="explore" name="explore" output="screen">
    <param name="max_frontier_search_radius" value="5.0" />
    <param name="plan_frequency" value="1.0" />
  </node>

  <!-- RViz -->
  <group if="$(arg open_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find turtlebot3_navigation)/rviz/turtlebot3_navigation.rviz" />
  </group>
</launch>

